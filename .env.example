# Configuration des clés API pour la génération 3D
# Remplissez ces clés après avoir créé un compte sur les plateformes respectives.
# Copiez ce fichier sous le nom ".env" (sans le .example)

# Meshy.ai API (https://meshy.ai)
VITE_MESHY_API_KEY=votre_cle_api_meshy_ici

# Luma AI API (https://lumalabs.ai)
VITE_LUMA_API_KEY=votre_cle_api_luma_ici

# Tripo3D API
VITE_TRIPO_API_KEY=votre_cle_api_tripo_ici

# CSM.ai API
VITE_CSM_API_KEY=votre_cle_api_csm_ici
